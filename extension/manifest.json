{
  "manifest_version": 3,
  "name": "Google Flow Bridge",
  "version": "1.0.0",
  "description": "Bridges local API/CLI/MCP server to Google Flow for automated image and video generation.",
  "permissions": [
    "tabs",
    "activeTab",
    "debugger",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "http://127.0.0.1:8766/*",
    "http://localhost:8766/*",
    "ws://127.0.0.1:8766/*",
    "ws://localhost:8766/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Google Flow Bridge",
    "default_popup": "popup.html"
  }
}
